# ==========================================
# LegalMetrix AI - Backend Environment Configuration
# ==========================================

APP_NAME=LegalMetrix AI
APP_ENV=development
API_V1_STR=/api/v1
DEBUG=True

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/legalmetrix

# JWT & Authentication Security
SECRET_KEY=change-me-in-production-legalmetrix-auth-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage & Upload Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGES_PER_SCAN=8

# ==========================================
# Development Seed User Credentials (DEV ONLY)
# ==========================================
DEV_ADMIN_EMAIL=admin@gmail.com
DEV_ADMIN_PASSWORD=Admin123
DEV_ADMIN_NAME=Dr. Rajesh Verma (Administrator)

DEV_INSPECTOR_EMAIL=inspector@gmail.com
DEV_INSPECTOR_PASSWORD=Inspector123
DEV_INSPECTOR_NAME=Aditi Sharma (Inspector)

DEV_REVIEWER_EMAIL=reviewer@gmail.com
DEV_REVIEWER_PASSWORD=Reviewer123
DEV_REVIEWER_NAME=Suresh Patel (Review Officer)

# ==========================================
# Day 4: Image Quality & OCR Configuration
# ==========================================
OCR_ENGINE=paddleocr
IMAGE_BLUR_THRESHOLD=100.0
IMAGE_GLARE_THRESHOLD=0.05
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400
OCR_LOW_CONFIDENCE_THRESHOLD=0.60
OCR_USE_ANGLE_CLS=True
OCR_LANG=en
